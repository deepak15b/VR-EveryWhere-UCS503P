<mxCell id="desc_l" value="5. Description&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;Provides access to the lightweight floating menu inside the VR tour, including Map, Information, Audio, Settings, and Exit Tour.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#b22222;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="198" width="660" height="92" as="geometry"/></mxCell>
<mxCell id="pre_l" value="5.1. Pre Conditions: &lt;font style=&quot;font-weight:normal&quot;&gt;User is inside a VR tour.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#b22222;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="660" height="48" as="geometry"/></mxCell>
<mxCell id="tasks_l" value="5.2. Task Sequence&lt;br&gt;1. User opens the lightweight floating VR menu.&lt;br&gt;2. System displays Map, Information, Audio, Settings, and Exit Tour options.&lt;br&gt;3. User selects the required menu option.&lt;br&gt;4. System opens or performs the corresponding supported function." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#b22222;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="338" width="660" height="127" as="geometry"/></mxCell>
<mxCell id="post_l" value="5.3. Post Conditions:&lt;br&gt;1. The selected VR menu function is accessed.&lt;br&gt;2. User can return to the VR exploration flow." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#b22222;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="465" width="660" height="81" as="geometry"/></mxCell>
