<mxCell id="desc_l" value="5. Description&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;Allows the user to view destinations that were previously saved for later exploration.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#b22222;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="198" width="660" height="92" as="geometry"/></mxCell>
